Rel(svc_notification, topic_booking_events, "Потребляет", "Kafka")
Rel(svc_notification, topic_driver_events, "Потребляет", "Kafka")
Rel(svc_notification, topic_payouts_events, "Потребляет", "Kafka")
Rel(svc_analytics, topic_booking_events, "Потребляет", "Kafka")
Rel(svc_analytics, topic_driver_events, "Потребляет", "Kafka")
Rel(svc_analytics, topic_driver_location, "Потребляет", "Kafka")
Rel(svc_analytics, topic_pricing_events, "Потребляет", "Kafka")
Rel(svc_analytics, topic_payments_events, "Потребляет", "Kafka")
Rel(svc_analytics, topic_payouts_events, "Потребляет", "Kafka")
Rel(svc_analytics, topic_fraud_events, "Потребляет", "Kafka")
Rel(svc_fraud, topic_booking_events, "Потребляет", "Kafka")
Rel(svc_fraud, topic_payments_events, "Потребляет", "Kafka")
