Rel(gateway, svc_booking, "Вызывает", "REST /v1,/v2")
Rel(gateway, svc_driver, "Вызывает", "REST /v1,/v2")
Rel(gateway, svc_pricing, "Вызывает", "gRPC/REST")
Rel(gateway, svc_payments, "Вызывает", "REST /v1,/v2")
Rel(gateway, svc_geography, "Вызывает", "gRPC/REST")

' ### SYNC МЕЖДУ СЕРВИСАМИ (критичный путь) ###
Rel(svc_booking, svc_driver, "Назначение водителя", "REST/gRPC")
Rel(svc_booking, svc_geography, "Геопоиск/ETA", "gRPC")
Rel(svc_booking, svc_pricing, "Расчёт цены", "gRPC")
Rel(svc_payments, svc_fraud, "Проверка транзакции", "REST")
Rel(svc_payouts, svc_driver, "Данные водителя", "REST/gRPC")

' ### САГА (Saga Orchestrator - компонент Booking Service) ###
Rel(svc_booking, topic_commands, "Отправляет команды саги", "Kafka")
Rel(svc_booking, topic_payments_events, "Потребляет результаты шагов саги", "Kafka")
Rel(svc_booking, topic_pricing_events, "Потребляет результаты шагов саги", "Kafka")
Rel(svc_booking, topic_driver_events, "Потребляет результаты шагов саги", "Kafka")
Rel(svc_booking, topic_fraud_events, "Потребляет результаты шагов саги", "Kafka")

