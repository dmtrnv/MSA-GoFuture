@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ### АКТОРЫ ###
Person(passenger, "Пассажир", "Заказывает поездки")
Person(driver, "Водитель", "Принимает заказы, получает выплаты")
Person(manager, "Корпоративный менеджер", "Управляет счетами")
Person(accountant, "Бухгалтер", "Контролирует выплаты")
Person(sre_engineer, "SRE инженер", "Поддерживает надёжность")

System_Boundary(go_future_system, "GoFuture Platform") {

    ' ### КЛИЕНТСКИЕ ПРИЛОЖЕНИЯ ###
    Container(app_passenger, "Пассажирское приложение", "iOS/Android/Huawei", "Интерфейс пассажира")
    Container(app_driver, "Водительское приложение", "iOS/Android/Huawei", "Интерфейс водителя")
    Container(web_portal, "Корпоративный веб-портал", "Web Application", "Управление корпоративными поездками")
    Container(admin_portal, "Админ-панель", "Web Application", "Операционное управление")

    ' ### ТОЧКА ВХОДА И ЗАЩИТА ПЕРИМЕТРА (в каждом регионе) ###
    System_Boundary(edge, "Edge / Integration / Защита периметра") {
        Container(ddos, "DDoS-защита / Scrubbing", "Anti-DDoS", "Поглощение объёмных атак (L3/L4/L7)")
        Container(waf, "WAF", "Web Application Firewall", "Инъекции, фильтрация HTTP(S)")
        Container(bot_protection, "Bot-защита", "Bot Mitigation", "Фильтрация автоматизированного абьюза")
        Container(gateway, "API Gateway / BFF", "Gateway", "Единая точка входа, маршрутизация, версионирование, rate limiting, auth")
    }

    ' ### СЕТЕВАЯ БЕЗОПАСНОСТЬ / ZERO-TRUST ###
    System_Boundary(netsec, "Сетевая безопасность / Zero-trust") {
        Container(firewall, "Firewall / Сегментация", "L3/L4 Firewall", "Least-privilege сетевые политики, сегментация зон")
        Container(ids, "IDS/IPS", "Intrusion Detection/Prevention", "Обнаружение и блокировка сетевых атак")
        Container(mesh, "Service Mesh", "mTLS / Zero-trust", "Шифрование и взаимная аутентификация сервис-сервис")
    }

    ' ### СОБЫТИЙНАЯ ПЛАТФОРМА ###
    System_Boundary(event_platform, "Событийная платформа") {

        ContainerQueue(kafka_broker, "Kafka Cluster", "Apache Kafka", "Backbone событий; region-aware partitioner; replication=3")
        Container(schema_registry, "Schema Registry", "Avro", "Контракты событий: регистрация схем продюсерами, выдача schema ID, режим BACKWARD")

        ' Ключевые топики (партиционирование по regionId:aggregateId)
        System_Boundary(topics, "Ключевые топики Kafka (partition key = regionId:aggregateId)") {
            ContainerQueue(topic_booking_events, "booking.booking.events.v1", "Kafka Topic", "BookingCreated, BookingConfirmed, TripStarted, TripCompleted, BookingCancelled")
            ContainerQueue(topic_driver_events, "driver.driver.events.v1", "Kafka Topic", "DriverAssigned, DriverStatusChanged, ShiftStarted/Ended")
            ContainerQueue(topic_driver_location, "driver.driver.location.v1", "Kafka Topic", "DriverLocationUpdated")
            ContainerQueue(topic_pricing_events, "pricing.pricing.events.v1", "Kafka Topic", "PriceQuoted, SurgeMultiplierUpdated")
            ContainerQueue(topic_payments_events, "payments.payment.events.v1", "Kafka Topic", "PaymentAuthorized, PaymentCaptured, PaymentFailed")
            ContainerQueue(topic_payouts_events, "payouts.payout.events.v1", "Kafka Topic", "PayoutInitiated, PayoutCompleted")
            ContainerQueue(topic_fraud_events, "fraud.fraud.events.v1", "Kafka Topic", "FraudDetected, RiskScored")
            ContainerQueue(topic_commands, "*.commands.v1", "Kafka Topic", "Команды Saga: PaymentAuthorizeRequested, DriverAssignmentRequested")
            ContainerQueue(topic_retry_dlq, "*.retry / *.dlq", "Kafka Topic", "Ретраи с backoff и Dead Letter")
        }

        Container(flink, "Stream Processing", "Apache Flink / Python", "Stateful/windowed: surge-цены, hot-zones, сессии поездки")
    }

    ' ### ДОМЕННЫЕ СЕРВИСЫ ###
    System_Boundary(services, "Доменные сервисы") {
        Container(svc_booking, "Booking Service", "Django/Python", "Жизненный цикл поездки, матчинг; содержит компонент Saga Orchestrator (оркестрация саги поездки и выплат, компенсации, таймауты)")
        Container(svc_driver, "Driver Service", "Django/Python", "Профиль, смены, заработок водителя")
        Container(svc_pricing, "Pricing Service", "Python", "Расчёт цены, динамическое ценообразование")
        Container(svc_payments, "Payments Service", "Python", "Приём платежей от пассажиров")
        Container(svc_payouts, "Payouts Service", "Python", "Выплаты водителям и партнёрам")
        Container(svc_notification, "Notification Service", "Python", "Push/SMS/email уведомления")
        Container(svc_geography, "Geography Service", "Python", "Геопоиск, зоны, маршруты, ETA")
        Container(svc_analytics, "Analytics Service", "Python", "Сбор событий, витрины")
        Container(svc_fraud, "Fraud Service", "Python", "Антифрод и риск-скоринг")
    }

    ' ### ХРАНИЛИЩА (database-per-service) ###
    System_Boundary(data, "Хранилища (database-per-service)") {
        ContainerDb(db_booking, "БД Booking", "PostgreSQL", "Бронирования, состояние поездки, outbox, saga_state")
        ContainerDb(db_driver, "БД Driver", "PostgreSQL", "Водители, смены, outbox")
        ContainerDb(db_pricing, "БД Pricing", "PostgreSQL", "Правила ценообразования, котировки")
        ContainerDb(db_payments, "БД Payments", "PostgreSQL", "Платежи, транзакции, outbox")
        ContainerDb(db_payouts, "БД Payouts", "PostgreSQL", "Выплаты, балансы, outbox")
        ContainerDb(db_notification, "БД Notification", "PostgreSQL", "Устройства, шаблоны")
        ContainerDb(db_geography, "БД Geography", "PostgreSQL", "Зоны")
        ContainerDb(db_geo_index, "Геоиндекс", "Elasticsearch", "Геопоиск водителей")
        ContainerDb(db_fraud, "БД Fraud", "PostgreSQL", "Правила антифрода, риск-скоры")
        ContainerDb(db_analytics, "Analytics Store", "ClickHouse", "События и агрегаты")
        Container(datalens, "DataLens", "BI Tool", "Визуализация бизнес-метрик и отчётов")
        ContainerDb(db_cache, "Кеш", "Redis", "Кеш цен, устройств, гео, схем событий")
    }

    ' ### НАБЛЮДАЕМОСТЬ ###
    System_Boundary(observability, "Наблюдаемость") {
        Container(otel_collector, "OpenTelemetry Collector", "OTel", "Прикладная телеметрия: приём OTLP (сервисы, Flink), скрейп ClickHouse /metrics, prometheusexporter")
        Container(kafka_lag_exporter, "Kafka Metrics Exporter", "Kafka Exporter", "Consumer lag, offset, throughput, партиции")
        Container(postgres_exporter, "Postgres Exporter", "postgres_exporter", "Метрики всех БД PostgreSQL: connections, replication lag, slow queries")
        Container(redis_exporter, "Redis Exporter", "redis_exporter", "Метрики Redis: memory, evictions, hit/miss, clients, replication")
        Container(es_exporter, "Elasticsearch Exporter", "elasticsearch_exporter", "Метрики ES: cluster health, JVM, thread pools, shards, latency")
        Container(jmx_exporter, "JMX Exporter", "jmx_exporter", "JMX-метрики Schema Registry (JVM): запросы, ошибки, схемы")
        Container(monitoring, "Prometheus", "Monitoring", "Хранилище метрик; скрейпит инфра-экспортеры напрямую и OTel Collector; SLI/SLO правила")
        Container(grafana, "Grafana", "Dashboards", "Дашборды: SLO/error budget, lag, DLQ, outbox, Flink")
        Container(loki, "Loki", "Logs", "Агрегация логов")
        Container(tracing, "Jaeger", "Distributed Tracing", "Сквозные трейсы событий и саг (OpenTelemetry)")
        Container(alert_manager, "Alertmanager", "Alerting", "Мультиоконные burn-rate алерты, lag/DLQ/Flink")
    }

    ' ### БЕЗОПАСНОСТЬ (регионально-распределённая) ###
    System_Boundary(security, "Безопасность (регионально-распределённая)") {
        Container(iam, "IAM / SSO", "Identity Management", "OAuth2/OIDC, RBAC, SSO, least privilege")
        Container(vault, "Vault / Secret Manager", "Secrets Management", "Хранение и ротация секретов (per-region)")
        Container(kms, "KMS", "Key Management", "Ключи шифрования данных at-rest (per-region)")
        Container(pii_vault, "Токенизация PII", "Tokenization", "Токенизация/маскирование PII и платёжных данных (PCI DSS)")
        Container(image_scan, "Скан образов / Admission", "Supply-chain Security", "Проверка уязвимостей образов и политики допуска")
        Container(siem, "SIEM / Audit", "Security Monitoring", "Корреляция событий безопасности и аномалий")
        ContainerDb(audit_store, "Неизменяемый аудит-стор", "Object Storage (WORM / Object Lock)", "Append-only аудит-логи, retention >= 1 год, per-region")
    }
}

' ### ВНЕШНИЕ СИСТЕМЫ ###
System_Ext(payment_gateway, "Платёжный шлюз", "Внешний провайдер")
System_Ext(maps_provider, "Картографический сервис", "Внешний провайдер")
System_Ext(fcm, "FCM", "Push Google")
System_Ext(apns, "APNs", "Push Apple")
System_Ext(huawei_push, "Huawei Push Kit", "Push Huawei")
