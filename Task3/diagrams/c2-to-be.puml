' ### КЛИЕНТЫ -> ШЛЮЗ ###
Rel(passenger, app_passenger, "Использует")
Rel(driver, app_driver, "Использует")
Rel(manager, web_portal, "Использует")
Rel(accountant, admin_portal, "Использует")
Rel(app_passenger, ddos, "Использует стабильный публичный контракт", "HTTPS/TLS 1.3")
Rel(app_driver, ddos, "Использует стабильный публичный контракт", "HTTPS/TLS 1.3")
Rel(web_portal, ddos, "Использует", "HTTPS/TLS 1.3")
Rel(admin_portal, ddos, "Использует", "HTTPS/TLS 1.3")

' ### ЗАЩИТА ПЕРИМЕТРА (DDoS -> WAF -> Bot -> Gateway) ###
Rel(ddos, waf, "Легитимный трафик после фильтрации", "HTTPS")
Rel(waf, bot_protection, "Фильтрация HTTP(S)", "Inline")
Rel(bot_protection, gateway, "Очищенный трафик", "HTTPS")
Rel(gateway, firewall, "Сегментация входящего/исходящего трафика", "L3/L4")
Rel(firewall, mesh, "Внутрирегиональный", "L3/L4")
Rel(firewall, ids, "Мониторинг трафика", "Network")

