Rel(svc_booking, topic_booking_events, "Публикует (outbox)", "Kafka")
Rel(svc_driver, topic_driver_events, "Публикует (outbox)", "Kafka")
Rel(svc_driver, topic_driver_location, "Публикует (outbox)", "Kafka")
Rel(svc_pricing, topic_pricing_events, "Публикует (outbox)", "Kafka")
