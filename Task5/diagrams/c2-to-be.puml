@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ### АКТОРЫ ###
Person(passenger, "Пассажир", "Заказывает поездки")
Person(driver, "Водитель", "Принимает заказы, получает выплаты")
Person(manager, "Корпоративный менеджер", "Управляет счетами")
Person(accountant, "Бухгалтер", "Контролирует выплаты")
Person(sre_engineer, "SRE инженер", "Поддерживает надёжность")
Person(platform_ops, "Platform Operations Admin", "Управляет жизненным циклом тенантов")
Person(tenant_admin, "Админ партнёра (тенанта)", "Управляет своим тенантом: пользователи, конфигурация, API")
Person(tenant_ops, "Оператор партнёра", "Операции своего тенанта")
Person(compliance_officer, "Комплаенс / DPO", "Проверки, DSR, аудит")
Person(soc_analyst, "SOC аналитик", "Мониторинг безопасности и инцидентов")
Person(onboarding_approver, "Onboarding Approver (KYC)", "Ревью и approve заявок онбординга")
Person(security_approver, "Security Approver", "Security-ревью и approve заявок онбординга")
Person(business_approver, "Business Approver", "Бизнес-approve заявок: тариф/SLA, tier, квоты")
Person(partner_prospect, "Партнёр (prospective)", "Регистрация и подача заявки онбординга (bootstrap)")

System_Boundary(go_future_system, "GoFuture Platform") {

    ' ### КЛИЕНТСКИЕ ПРИЛОЖЕНИЯ ###
    Container(app_passenger, "Пассажирское приложение", "iOS/Android/Huawei", "Интерфейс пассажира")
    Container(app_driver, "Водительское приложение", "iOS/Android/Huawei", "Интерфейс водителя")
    Container(web_portal, "Корпоративный веб-портал", "Web Application", "Управление корпоративными поездками")
    Container(admin_portal, "Админ-панель", "Web Application", "Операционное управление")
    Container(partner_portal, "Партнёрский портал (self-service)", "Web Application", "Онбординг, конфигурация, квоты, usage и SLO тенанта")

    ' ### МУЛЬТИТЕНАНТНОСТЬ / CONTROL PLANE (TENANT PLANE) ###
    System_Boundary(mt_control_plane, "Мультитенантность / Control Plane") {
        Container(tenant_registry_svc, "Tenant Registry", "Service (регион-primary + глобальный свод)", "Система-рекорд тенантов: tenantId, суб-регион, tier изоляции, статус, квоты, конфигурация")
        ContainerDb(db_tenant_registry, "БД Tenant Registry", "PostgreSQL (per-region + свод)", "Реестр тенантов региона; асинхронный свод метаданных (не PII бизнес-данных)")
        Container(onboarding, "Onboarding Orchestrator", "Workflow (Temporal/Camunda)", "Состояния онбординга, approval-workflow, SLA-таймеры, компенсации (saga онбординга)")
        Container(provisioning, "Provisioning Operator", "K8s Operator / Terraform + ArgoCD", "Идемпотентный провижининг: Keycloak org/clients, БД+RLS/silo, топики, квоты, KMS, monitoring-rules")
        Container(tenant_config, "Tenant Config Service", "Config / Feature Flags", "Раздача конфигурации, фича-флагов, брендинга, локальных интеграций тенанта")
        Container(quota_metering, "Quota & Usage Metering", "Service + ClickHouse sink", "Квоты и учёт потребления на тенанта; источник биллинга и FinOps")
        Container(sandbox, "Sandbox (per суб-регион)", "Environment", "Приёмочные тесты онбординга: SSO, тестовая поездка, тест изоляции; синтетические данные")
    }

    ' ### ТОЧКА ВХОДА И ЗАЩИТА ПЕРИМЕТРА (в каждом регионе) ###
    System_Boundary(edge, "Edge / Integration / Защита периметра") {
        Container(ddos, "DDoS-защита / Scrubbing", "Anti-DDoS", "Поглощение объёмных атак (L3/L4/L7)")
        Container(waf, "WAF", "Web Application Firewall", "Инъекции, фильтрация HTTP(S)")
        Container(bot_protection, "Bot-защита", "Bot Mitigation", "Фильтрация автоматизированного абьюза")
        Container(gateway, "API Gateway / BFF", "Gateway", "Единая точка входа, маршрутизация, версионирование, rate limiting, auth")
    }

    ' ### СЕТЕВАЯ БЕЗОПАСНОСТЬ / ZERO-TRUST ###
    System_Boundary(netsec, "Сетевая безопасность / Zero-trust") {
        Container(firewall, "Firewall / Сегментация", "L3/L4 Firewall", "Least-privilege сетевые политики, сегментация зон")
        Container(ids, "IDS/IPS", "Intrusion Detection/Prevention", "Обнаружение и блокировка сетевых атак")
        Container(mesh, "Service Mesh", "mTLS / Zero-trust", "Шифрование и взаимная аутентификация сервис-сервис")
    }

    ' ### СОБЫТИЙНАЯ ПЛАТФОРМА ###
    System_Boundary(event_platform, "Событийная платформа") {

        ContainerQueue(kafka_broker, "Kafka Cluster", "Apache Kafka", "Backbone событий; region-aware partitioner; replication=3")
        Container(schema_registry, "Schema Registry", "Avro", "Контракты событий: регистрация схем продюсерами, выдача schema ID, режим BACKWARD")

        ' Ключевые топики (партиционирование по regionId:tenantId:aggregateId; tenant-aware версии *.v2)
        System_Boundary(topics, "Ключевые топики Kafka (key = regionId:tenantId:aggregateId, *.v2)") {
            ContainerQueue(topic_booking_events, "booking.booking.events.v2", "Kafka Topic", "BookingCreated, BookingConfirmed, TripStarted, TripCompleted, BookingCancelled")
            ContainerQueue(topic_driver_events, "driver.driver.events.v2", "Kafka Topic", "DriverAssigned, DriverStatusChanged, ShiftStarted/Ended")
            ContainerQueue(topic_driver_location, "driver.driver.location.v2", "Kafka Topic", "DriverLocationUpdated")
            ContainerQueue(topic_pricing_events, "pricing.pricing.events.v2", "Kafka Topic", "PriceQuoted, SurgeMultiplierUpdated")
            ContainerQueue(topic_payments_events, "payments.payment.events.v2", "Kafka Topic", "PaymentAuthorized, PaymentCaptured, PaymentFailed")
            ContainerQueue(topic_payouts_events, "payouts.payout.events.v2", "Kafka Topic", "PayoutInitiated, PayoutCompleted")
            ContainerQueue(topic_fraud_events, "fraud.fraud.events.v2", "Kafka Topic", "FraudDetected, RiskScored")
            ContainerQueue(topic_geography_events, "geography.zone.events.v2", "Kafka Topic", "ZoneUpdated, GeoIndexUpdated, RouteCalculated")
            ContainerQueue(topic_cdc, "*.cdc.v2", "Kafka Topic", "CDC-изменения (Notification: устройства, шаблоны)")
            ContainerQueue(topic_commands, "*.commands.v2", "Kafka Topic", "Команды Saga: PaymentAuthorizeRequested, DriverAssignmentRequested")
            ContainerQueue(topic_retry_dlq, "*.retry / *.dlq", "Kafka Topic", "Ретраи с backoff и Dead Letter")
        }

        note right of topics
          Tenant-aware ключ regionId:tenantId:aggregateId (ADR-025):
          переход на новые версии топиков *.v2 -
          двойная публикация v1+v2 -> cut-over консьюмеров -> вывод v1
          (ADR-008, совместимость конверта - ADR-004).
          На схеме показано ЦЕЛЕВОЕ состояние (*.v2).
        end note

        Container(flink, "Stream Processing", "Apache Flink / Python", "Stateful/windowed: surge-цены, hot-zones, сессии поездки")
    }

    ' ### ДОМЕННЫЕ СЕРВИСЫ ###
    System_Boundary(services, "Доменные сервисы") {
        Container(svc_booking, "Booking Service", "Django/Python", "Жизненный цикл поездки, матчинг; содержит компонент Saga Orchestrator (оркестрация саги поездки и выплат, компенсации, таймауты)")
        Container(svc_driver, "Driver Service", "Django/Python", "Профиль, смены, заработок водителя")
        Container(svc_pricing, "Pricing Service", "Python", "Расчёт цены, динамическое ценообразование")
        Container(svc_payments, "Payments Service", "Python", "Приём платежей от пассажиров")
        Container(svc_payouts, "Payouts Service", "Python", "Выплаты водителям и партнёрам")
        Container(svc_notification, "Notification Service", "Python", "Push/SMS/email уведомления")
        Container(svc_geography, "Geography Service", "Python", "Геопоиск, зоны, маршруты, ETA")
        Container(svc_analytics, "Analytics Service", "Python", "Сбор событий, витрины (легаси; заменяется платформой данных)")
        Container(svc_fraud, "Fraud Service", "Python", "Антифрод и риск-скоринг")
    }

    ' ### ХРАНИЛИЩА (database-per-service) ###
    System_Boundary(data, "Хранилища (database-per-service)") {
        ContainerDb(db_booking, "БД Booking", "PostgreSQL", "Бронирования, состояние поездки, outbox, saga_state")
        ContainerDb(db_driver, "БД Driver", "PostgreSQL", "Водители, смены, outbox")
        ContainerDb(db_pricing, "БД Pricing", "PostgreSQL", "Правила ценообразования, котировки")
        ContainerDb(db_payments, "БД Payments", "PostgreSQL", "Платежи, транзакции, outbox")
        ContainerDb(db_payouts, "БД Payouts", "PostgreSQL", "Выплаты, балансы, outbox")
        ContainerDb(db_notification, "БД Notification", "PostgreSQL", "Устройства, шаблоны")
        ContainerDb(db_geography, "БД Geography", "PostgreSQL", "Зоны")
        ContainerDb(db_geo_index, "Геоиндекс", "Elasticsearch", "Геопоиск водителей")
        ContainerDb(db_fraud, "БД Fraud", "PostgreSQL", "Правила антифрода, риск-скоры")
        ContainerDb(db_analytics, "Analytics / Gold Store", "ClickHouse", "Regional gold-витрины платформы данных; пока и легаси-запись Analytics Service")
        ContainerDb(db_usage, "Usage / Billing Store", "ClickHouse (tenant-витрины)", "Учёт потребления и биллинг-метрики на тенанта; отдельно от бизнес-витрин gold")
        ContainerDb(db_cache, "Кеш", "Redis", "Кеш цен, устройств, гео, схем событий, tenant-config/tenant resolution; online-признаки (Feature Store)")
    }

    ' ### ПЛАТФОРМА ДАННЫХ И ML ###
    System_Boundary(data_ml, "Платформа данных и ML (Lakehouse + ML)") {
        Container(ingest, "Streaming Ingest", "Apache Flink (Iceberg Sink)", "Сбор доменных событий из Kafka в bronze; дедупликация, токенизация PII, валидация контрактов")
        Container(cdc, "CDC (Debezium) - точечно", "Debezium", "Данные без доменных событий (Notification: устройства, шаблоны): читает WAL → Kafka → тот же ingest + DQ")
        ContainerDb(lakehouse, "Lakehouse", "Object Storage (S3) + Apache Iceberg", "Bronze/Silver: сырые и очищенные доменные данные; time travel, эволюция схем, PII-токенизация")
        ContainerDb(feature_offline, "Feature / Offline (gold)", "Iceberg / Parquet", "Обучающие признаки (point-in-time), материализуются из silver; offline-store для Feast")
        Container(iceberg_catalog, "Iceberg REST Catalog", "REST Catalog / Metastore", "Метаданные таблиц Iceberg per-region: схемы, snapshots, эволюция; единая точка для Spark/Flink/dbt")
        Container(batch_transform, "Batch Transform", "Apache Spark", "Batch/backfill: переработка истории, обучающие датасеты, батч-скоринг, агрегаты")
        Container(dbt, "dbt", "SQL Transform", "Моделирование витрин gold на ClickHouse; единые определения метрик")
        Container(dq, "Data Quality Engine", "Great Expectations", "Проверки качества на переходе слоёв; карантин дефектных данных")
        ContainerDb(dq_quarantine, "Карантин данных", "Object Storage / Table", "Изоляция записей, не прошедших DQ; разбор и replay")
        Container(catalog, "Data Catalog & Lineage", "OpenMetadata", "Каталог, владельцы, классификация PII, сквозной lineage")
        Container(feature_store, "Feature Store", "Feast", "Offline (Iceberg) + online (Redis) признаки для обучения и инференса")
        Container(mlflow, "ML Platform / Registry", "MLflow", "Трекинг экспериментов, версии и стадии моделей, артефакты")
        Container(training, "ML Training", "Python / Spark / GPU", "Обучение моделей: спрос, ценообразование, антифрод; backtests")
        Container(model_serving, "Model Serving", "KServe", "Онлайн/батч-инференс предсказаний, canary/A-B")
        Container(airflow, "Orchestration", "Airflow", "DAG: dataset → train → evaluate → register → deploy; batch/backfill, dbt, материализация признаков")
    }

    ' ### BI И ГЛОБАЛЬНАЯ АНАЛИТИКА ###
    System_Boundary(bi, "BI и глобальная аналитика") {
        ContainerDb(global_analytics, "Global Analytics", "ClickHouse", "Кросс-региональные деидентифицированные агрегаты для глобального BI")
        Container(datalens, "DataLens", "BI Tool", "Дашборды: бизнес-метрики, финансы, антифрод, DQ (региональные + глобальные)")
    }

    ' ### НАБЛЮДАЕМОСТЬ ###
    System_Boundary(observability, "Наблюдаемость") {
        Container(otel_collector, "OpenTelemetry Collector", "OTel", "Прикладная телеметрия: приём OTLP (сервисы, Flink), скрейп ClickHouse /metrics, prometheusexporter")
        Container(kafka_lag_exporter, "Kafka Metrics Exporter", "Kafka Exporter", "Consumer lag, offset, throughput, партиции")
        Container(postgres_exporter, "Postgres Exporter", "postgres_exporter", "Метрики всех БД PostgreSQL: connections, replication lag, slow queries")
        Container(redis_exporter, "Redis Exporter", "redis_exporter", "Метрики Redis: memory, evictions, hit/miss, clients, replication")
        Container(es_exporter, "Elasticsearch Exporter", "elasticsearch_exporter", "Метрики ES: cluster health, JVM, thread pools, shards, latency")
        Container(jmx_exporter, "JMX Exporter", "jmx_exporter", "JMX-метрики Schema Registry (JVM): запросы, ошибки, схемы")
        Container(monitoring, "Prometheus", "Monitoring", "Хранилище метрик; скрейпит инфра-экспортеры напрямую и OTel Collector; SLI/SLO правила")
        Container(grafana, "Grafana", "Dashboards", "Дашборды: SLO/error budget, lag, DLQ, outbox, Flink")
        Container(loki, "Loki", "Logs", "Агрегация логов")
        Container(tracing, "Jaeger", "Distributed Tracing", "Сквозные трейсы событий и саг (OpenTelemetry)")
        Container(alert_manager, "Alertmanager", "Alerting", "Мультиоконные burn-rate алерты, lag/DLQ/Flink; маршруты: партнёр / SRE / SOC")
        Container(tenant_slo, "Tenant SLI/SLO Rules", "Prometheus recording rules", "Per-tenant SLI/SLO, error budget, burn-rate; курируемый набор метрик с tenant_id")
        Container(noisy_neighbor, "Noisy-neighbor / QoS Monitor", "Anomaly Detection", "Атрибуция нагрузки/ресурсов на тенанта, детект шумного соседа (pooled)")
        Container(isolation_probe, "Isolation Probes", "Synthetic Tests", "Периодические проверки изоляции: тенант A не видит данные тенанта B (API/данные)")
        Container(tenant_dash, "Tenant Dashboard / Status", "Grafana (tenant-scoped)", "Кабинет партнёра: свой SLO, usage, инциденты (tenant-scoped datasource или прокси с принудительным tenant-фильтром; без RLS в Grafana)")
    }

    ' ### БЕЗОПАСНОСТЬ (регионально-распределённая) ###
    System_Boundary(security, "Безопасность (регионально-распределённая)") {
        ' ### IAM (Keycloak) - регионально-распределённый ###
        System_Boundary(iam_plane, "IAM / SSO (Keycloak)") {
            Container(keycloak_region, "Keycloak (realm-per-region)", "Keycloak", "Realm на суб-регион: пассажиры, водители, корп-клиенты, staff и организации тенантов; OIDC/OAuth2, SSO, MFA, token exchange")
            ContainerDb(db_keycloak_region, "БД Keycloak (регион)", "PostgreSQL", "Идентичности, сессии, организации тенантов суб-региона (резидентность PII идентичностей)")
            Container(keycloak_platform, "Keycloak (platform realm)", "Keycloak", "Глобальный realm: платформенные админы, автоматизация, service accounts, break-glass")
            ContainerDb(db_keycloak_platform, "БД Keycloak (platform, hub)", "PostgreSQL (hub)", "Платформенные аккаунты, service accounts, роли; массовых PII нет")
            Container(authz_service, "Authorization Service (RBAC+ABAC)", "Библиотека / OPA", "Решения доступа: роли + атрибуты tenant_id/region/clearance; политики версионируются в Git; permissions/scopes в токене")
        }

        Container(vault, "Vault / Secret Manager", "Secrets Management", "Хранение и ротация секретов (per-region)")
        Container(kms, "KMS", "Key Management", "Ключи шифрования данных at-rest (per-region)")
        Container(pii_vault, "Токенизация PII", "Tokenization", "Токенизация/маскирование PII и платёжных данных (PCI DSS)")
        Container(dsr, "DSR / Data Map", "Subject Rights", "Права субъектов (доступ/исправление/удаление/портируемость); data map субъект→регион; удаление - crypto-shredding per-subject ключа")
        Container(image_scan, "Скан образов / Admission", "Supply-chain Security", "Проверка уязвимостей образов и политики допуска")
        Container(siem, "SIEM / Audit", "Security Monitoring", "Корреляция событий безопасности и аномалий")
        ContainerDb(audit_store, "Неизменяемый аудит-стор", "Object Storage (WORM / Object Lock)", "Append-only аудит-логи, retention >= 1 год, per-region")
    }
}

' ### ВНЕШНИЕ СИСТЕМЫ ###
System_Ext(payment_gateway, "Платёжный шлюз", "Внешний провайдер")
System_Ext(maps_provider, "Картографический сервис", "Внешний провайдер")
System_Ext(fcm, "FCM", "Push Google")
System_Ext(apns, "APNs", "Push Apple")
System_Ext(huawei_push, "Huawei Push Kit", "Push Huawei")
System_Ext(bank_api, "API Банка", "Банковские выплаты")

' ### КЛИЕНТЫ -> ШЛЮЗ ###
Rel(passenger, app_passenger, "Использует")
Rel(driver, app_driver, "Использует")
Rel(manager, web_portal, "Использует")
Rel(accountant, admin_portal, "Использует")
Rel(app_passenger, ddos, "Использует стабильный публичный контракт", "HTTPS/TLS 1.3")
Rel(app_driver, ddos, "Использует стабильный публичный контракт", "HTTPS/TLS 1.3")
Rel(web_portal, ddos, "Использует", "HTTPS/TLS 1.3")
Rel(admin_portal, ddos, "Использует", "HTTPS/TLS 1.3")

' ### ЗАЩИТА ПЕРИМЕТРА (DDoS -> WAF -> Bot -> Gateway) ###
Rel(ddos, waf, "Легитимный трафик после фильтрации", "HTTPS")
Rel(waf, bot_protection, "Фильтрация HTTP(S)", "Inline")
Rel(bot_protection, gateway, "Очищенный трафик", "HTTPS")
Rel(gateway, firewall, "Сегментация входящего/исходящего трафика", "L3/L4")
Rel(firewall, mesh, "Внутрирегиональный", "L3/L4")
Rel(firewall, ids, "Мониторинг трафика", "Network")

' ### ШЛЮЗ -> СЕРВИСЫ (sync, версионирование) ###
Rel(gateway, svc_booking, "Вызывает", "REST /v1,/v2")
Rel(gateway, svc_driver, "Вызывает", "REST /v1,/v2")
Rel(gateway, svc_pricing, "Вызывает", "gRPC/REST")
Rel(gateway, svc_payments, "Вызывает", "REST /v1,/v2")
Rel(gateway, svc_geography, "Вызывает", "gRPC/REST")

' ### SYNC МЕЖДУ СЕРВИСАМИ (критичный путь) ###
Rel(svc_booking, svc_driver, "Назначение водителя", "REST/gRPC")
Rel(svc_booking, svc_geography, "Геопоиск/ETA", "gRPC")
Rel(svc_booking, svc_pricing, "Расчёт цены", "gRPC")
Rel(svc_payments, svc_fraud, "Проверка транзакции", "REST")
Rel(svc_payouts, svc_driver, "Данные водителя", "REST/gRPC")

' ### САГА (Saga Orchestrator - компонент Booking Service) ###
Rel(svc_booking, topic_commands, "Отправляет команды саги", "Kafka")
Rel(svc_booking, topic_payments_events, "Потребляет результаты шагов саги", "Kafka")
Rel(svc_booking, topic_pricing_events, "Потребляет результаты шагов саги", "Kafka")
Rel(svc_booking, topic_driver_events, "Потребляет результаты шагов саги", "Kafka")
Rel(svc_booking, topic_fraud_events, "Потребляет результаты шагов саги", "Kafka")

' ### ПУБЛИКАЦИЯ: Transactional Outbox -> Kafka ###
Rel(svc_booking, topic_booking_events, "Публикует (outbox)", "Kafka")
Rel(svc_driver, topic_driver_events, "Публикует (outbox)", "Kafka")
Rel(svc_driver, topic_driver_location, "Публикует (outbox)", "Kafka")
